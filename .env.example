# Discord Configuration
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=1530041420579340400
BOT_OWNER_ID=your_discord_id
BOT_NAME=Legacy Bot
BOT_PREFIX=/

# Database Configuration
# Escolha: postgresql ou sqlite
DATABASE_TYPE=postgresql

# Se usar PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=legacy_bot
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_URL=postgresql://user:password@localhost:5432/legacy_bot

# Se usar SQLite
# DATABASE_PATH=./data/legacy_bot.db

# Roblox API
ROBLOX_API_URL=https://users.roblox.com/v1/users/by-username
ROBLOX_PROFILE_URL=https://www.roblox.com/users

# Web Dashboard (Futuro)
WEB_PORT=3000
WEB_HOST=localhost
JWT_SECRET=your_jwt_secret_here

# Environment
NODE_ENV=development
LOG_LEVEL=info

# Security
API_RATE_LIMIT=100
MAX_COMMAND_COOLDOWN=5000
